<div class="ec-wrapper">

    <div class="ec-card">

        <!-- ENCABEZADO -->
        <div class="ec-header">
            <div class="ec-header-content">
                <div class="ec-header-icon">▣</div>

                <div>
                    <h2 class="ec-title">Estado de Cuenta</h2>
                    <p class="ec-subtitle">Detalle de préstamo y movimientos</p>
                </div>
            </div>
        </div>


        <!-- INFORMACIÓN DEL PRÉSTAMO -->
        <div class="ec-section">

            <div class="ec-section-title">
                <span class="ec-section-line"></span>
                Información del préstamo
            </div>

            <div class="ec-info-grid">

                <div class="ec-info-item">
                    <span class="ec-label">Cliente</span>
                    <strong class="ec-value">
                        {{pres.nombre}}
                    </strong>
                </div>

                <div class="ec-info-item">
                    <span class="ec-label">Ruta</span>
                    <strong class="ec-value">
                        {{pres.cobRuta}}
                    </strong>
                </div>

                <div class="ec-info-item ec-info-wide">
                    <span class="ec-label">Detalle</span>
                    <strong class="ec-value">
                        {{pres.detalle}}
                    </strong>
                </div>

                <div class="ec-info-item">
                    <span class="ec-label">Plan</span>
                    <strong class="ec-value">
                        {{pres.plan}}
                    </strong>
                </div>

                <div class="ec-info-item">
                    <span class="ec-label">Cuotas</span>
                    <strong class="ec-value">
                        {{pres.cuotas}}
                    </strong>
                </div>

                <div class="ec-info-item">
                    <span class="ec-label">Valor de cuota</span>
                    <strong class="ec-value">
                        {{cuota}}
                    </strong>
                </div>

                <div class="ec-info-item">
                    <span class="ec-label">Fecha de inicio</span>
                    <strong class="ec-value">
                        {{pres.fechaInicio}}
                    </strong>
                </div>

                <div class="ec-info-item">
                    <span class="ec-label">Vencimiento</span>
                    <strong class="ec-value">
                        {{pres.fechaFinal}}
                    </strong>
                </div>

            </div>

        </div>


        <!-- RESUMEN FINANCIERO -->
        <div class="ec-finance-grid">

            <div class="ec-money-card">
                <span class="ec-money-label">Monto</span>
                <strong class="ec-money-value">
                    {{total}}
                </strong>
            </div>

            <div class="ec-money-card ec-money-green">
                <span class="ec-money-label">Adelanto</span>
                <strong class="ec-money-value">
                    {{adelanto}}
                </strong>
            </div>

            <div class="ec-money-card ec-money-blue">
                <span class="ec-money-label">Saldo pendiente</span>
                <strong class="ec-money-value">
                    {{mTotal}}
                </strong>
            </div>

        </div>


        <!-- HISTORIAL DE PAGOS -->
        <div class="ec-section ec-payments-section">

            <div class="ec-section-title">
                <span class="ec-section-line"></span>
                Historial de pagos
            </div>

            <div class="ec-table-container">

                <table class="ec-payments-table">

                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Pago</th>
                            <th>Código</th>
                        </tr>
                    </thead>

                    <tbody>

                        {{#each array}}

                        <tr>

                            <td>
                                {{fechaString}}
                            </td>

                            <td class="ec-payment-amount">
                                {{pago}}
                            </td>

                            <td class="ec-payment-code">
                                {{id}}
                            </td>

                        </tr>

                        {{/each}}

                    </tbody>

                </table>

            </div>

        </div>


        <!-- TRANSFERENCIA -->
        <div class="ec-transfer">

            <div class="ec-transfer-header">
                <div class="ec-transfer-icon">
                    $
                </div>

                <div>
                    <h3>Datos para pagos por transferencia</h3>
                    <p>Utilice estos datos para realizar su pago</p>
                </div>
            </div>


            <div class="ec-transfer-data">

                <div class="ec-transfer-row">
                    <span>Titular</span>
                    <strong>
                        CARLOS EDUARDO FUENMAYOR VILLARREAL
                    </strong>
                </div>

                <div class="ec-transfer-row">
                    <span>Alias</span>
                    <strong class="ec-copy-data">
                        maxitodo.sde
                    </strong>
                </div>

                <div class="ec-transfer-row">
                    <span>CBU</span>
                    <strong class="ec-copy-data">
                        0720364888000002553636
                    </strong>
                </div>

            </div>

        </div>


        <!-- PIE -->
        <div class="ec-footer">
            <span>Estado de cuenta</span>
            <span>Documento informativo</span>
        </div>

    </div>

</div>