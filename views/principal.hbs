<nav class="app-header">

    <div class="app-header-left">
        <a href="/vistas/exit"
           class="logout-btn"
           onclick="return confirm('¿Desea cerrar sesion?')"
           title="Cerrar sesión">
            <i class="bi bi-box-arrow-left"></i>
        </a>
    </div>

    <div class="app-brand">
        
        <div>
            <strong>Cobranza App</strong>
            <span>Gestión y administración</span>
        </div>
    </div>

    <div class="app-user">
        <i class="bi bi-person-circle"></i>
        <span>{{nombre}}</span>
    </div>

</nav>


<div class="dashboard-layout">

    <!-- MENÚ LATERAL -->
    <aside class="dashboard-sidebar">

        <div class="sidebar-title">
            <i class="bi bi-grid-1x2-fill"></i>
            <span>Panel de control</span>
        </div>


        <div class="menu-grid">

            <a class="menu-card menu-primary" href="/general">
                <i class="bi bi-cash-coin"></i>
                <span>Rutas de cobro</span>
            </a>

            <a class="menu-card" href="/vistas/Clientes">
                <i class="bi bi-people"></i>
                <span>Clientes</span>
            </a>

            <a class="menu-card" href="/products/productos/">
                <i class="bi bi-cart4"></i>
                <span>Gestión Productos</span>
            </a>

            <a class="menu-card" href="/products/productosUsuarios">
                <i class="bi bi-shop"></i>
                <span>Catálogo Productos</span>
            </a>

            <a class="menu-card" href="/ventas">
                <i class="bi bi-receipt-cutoff"></i>
                <span>Ventas</span>
            </a>

            <a class="menu-card" href="/cobranza/transf">
                <i class="bi bi-bank"></i>
                <span>Transferencias</span>
            </a>

            <a class="menu-card" href="/calculadora">
                <i class="bi bi-calculator"></i>
                <span>Calculadora</span>
            </a>

            <a class="menu-card" href="/vistas/usuarios">
                <i class="bi bi-person-workspace"></i>
                <span>Usuarios</span>
            </a>

            <a class="menu-card" href="/settings">
                <i class="bi bi-gear"></i>
                <span>Configuración</span>
            </a>

            <a class="menu-card menu-alert" href="/alertas">
                <i class="bi bi-exclamation-octagon"></i>
                <span>Alertas</span>
            </a>

            <a class="menu-card" href="/cobranza/generarBalance"
               onclick="return confirm('¿Desea crear planillas de cobranza?')">
                <i class="bi bi-file-earmark-ruled"></i>
                <span>Crear Planillas</span>
            </a>

            <a class="menu-card" href="/cxp">
                <i class="bi bi-credit-card"></i>
                <span>CXP</span>
            </a>

        </div>

    </aside>


    <!-- CONTENIDO PRINCIPAL -->
    <main class="dashboard-content">

        <!-- CABECERA -->
        <section class="content-header">

            <div>
                <span class="content-kicker">
                    <i class="bi bi-speedometer2"></i>
                    Panel principal
                </span>

                <h1>Resumen de cobranza</h1>

                <p>
                    Consulta y administra las planillas de cobranza
                    y la información de tus clientes.
                </p>
            </div>

            <div class="header-date">
                <i class="bi bi-calendar3"></i>
                <span>Gestión diaria</span>
            </div>

        </section>


        <!-- PLANILLAS -->
        <section class="dashboard-panel">

            <div class="panel-heading">

                <div class="panel-heading-icon">
                    <i class="bi bi-wallet2"></i>
                </div>

                <div>
                    <h2>Planillas de cobranza</h2>
                    <span>Seguimiento de cobros programados</span>
                </div>

            </div>


            <div class="table-wrapper">

                <table class="modern-table">

                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Ruta</th>
                            <th>Nombre</th>
                            <th>Esperado</th>
                            <th>Cobrado</th>
                        </tr>
                    </thead>

                    <tbody>

                    {{#each rutas}}

                        <tr>

                            <td data-label="Fecha">
                                <span class="date-cell">
                                    <i class="bi bi-calendar3"></i>
                                    {{fecha}}
                                </span>
                            </td>

                            <td data-label="Ruta">
                                <span class="route-badge">
                                    {{cobRuta}}
                                </span>
                            </td>

                            <td data-label="Nombre">
                                <strong>{{nombre}}</strong>
                            </td>

                            <td data-label="Esperado">
                                <span class="money expected">
                                    {{esperado}}
                                </span>
                            </td>

                            <td data-label="Cobrado">
                                <span class="money collected">
                                    {{cobrado}}
                                </span>
                            </td>

                        </tr>

                    {{/each}}

                    </tbody>

                </table>

            </div>

        </section>


        <!-- CLIENTES -->
        <section class="dashboard-panel">

            <div class="panel-heading">

                <div class="panel-heading-icon">
                    <i class="bi bi-person-plus"></i>
                </div>

                <div>
                    <h2>Clientes agregados recientemente</h2>
                    <span>Últimos clientes registrados</span>
                </div>

            </div>

            <div class="recent-clientes">

                <!-- Aquí puedes colocar posteriormente el each de clientes -->

                <div class="empty-state">
                    <i class="bi bi-people"></i>

                    <strong>No hay información reciente</strong>

                    <span>
                        Los nuevos clientes aparecerán en esta sección.
                    </span>
                </div>

            </div>

        </section>

    </main>

</div>