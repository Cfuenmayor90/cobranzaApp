<section class="habladores-page">

    <div class="habladores-grid">

        {{#each arrayPrpoductos}}

        <article class="hablador">

            <div class="hablador-header" style="background-color:azure;">
                <img
                    src="/logo.png"
                    alt="MaxiTodo"
                    class="hablador-logo"
                >
            </div>

            <div class="hablador-content">

                <h2 class="hablador-producto">
                    {{producto}}
                </h2>

                <div class="hablador-codigo">
                    CÓD. {{cod}}
                </div>

                <div class="hablador-precio">
                    <span>PRECIO</span>
                    <strong>{{precioTartj}}</strong>
                </div>

                <div class="hablador-financiacion">

                    <div class="hablador-plan tarjeta">
                        <strong>3 CUOTAS SIN INTERÉS</strong>
                        <span>Con tarjeta de crédito</span>
                        <b>{{vCuota}}</b>
                    </div>

                    <div class="hablador-plan diario">
                        <strong>CUOTAS DIARIAS</strong>
                        <span>Para comerciantes</span>
                        <b>Desde {{vCuota}}</b>
                    </div>

                    <div class="hablador-plan semanal">
                        <strong>CUOTAS SEMANALES</strong>
                        <span>Para comerciantes</span>
                        <b>Desde {{vCuota}}</b>
                    </div>

                </div>

                <div class="hablador-contado">
                    <span>PRECIO CONTADO</span>
                    <strong>{{precio}}</strong>
                </div>

            </div>

            <div class="hablador-footer">
                <span>Consultá por financiación</span>
                <span>MAXITODO</span>
            </div>

        </article>

        {{/each}}

    </div>

</section>
